# All shell/install files run on Android — they MUST be LF, never CRLF.
# Force git to check them out with LF on every platform.
*.sh         text eol=lf
*.rule       text eol=lf
*.prop       text eol=lf
module.prop  text eol=lf
target.txt   text eol=lf
daemon       text eol=lf
description.txt  text eol=lf
update-binary    text eol=lf
updater-script   text eol=lf

# Build-time config sourced by build.sh. A CRLF checkout would put a CR inside
# PIF_TAG, and the download URL then dies as "malformed" — the same failure the
# upstream-update script once baked into build.sh.
*.conf       text eol=lf
*.override   text eol=lf

# Native binaries / archives — never touch
*.so         binary
*.dex        binary
*.zip        binary
*.png        binary
*.jpg        binary
*.jpeg       binary
keybox.xml   binary
