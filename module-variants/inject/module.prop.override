# module.prop keys this line overrides. Applied by build.sh after module/ is
# staged, so version / versionCode stay defined once, in module/module.prop.
# The two lines update independently, hence the separate manifest.
updateJson=https://raw.githubusercontent.com/evoker0/AlwaysStrong/main/update-inject.json
description=Strong Play Integrity in one drop-in module. Hardware attestation + an auto-refreshed Pixel fingerprint. Tap Action.
